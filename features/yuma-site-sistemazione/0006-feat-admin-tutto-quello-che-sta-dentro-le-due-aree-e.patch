+function safeUrl(u) {
+  var s = String(u || '').trim();
+  return /^https?:\/\//i.test(s) ? s : '';
+}
+const SOCI_ACCENT = { title: 'text-emerald-400', badge: 'border-emerald-500/40 text-emerald-300 bg-emerald-500/10', border: 'border-emerald-500/20' };
