+/* -------------------------------------------------------------------
+   ADMIN – gestione dei contenuti delle due aree (tab "Aree")
+   Le scritture sono consentite solo all'admin anche dalle policy RLS.
+   ------------------------------------------------------------------- */
+function renderAdminDownloads() {
+  ['soci', 'yuma'].forEach(function(area) {
+    var box = document.getElementById(area === 'soci' ? 'adminDownloadsSoci' : 'adminDownloadsYuma');
+    if (!box) return;
+    var items = areaDownloads(area);
+    if (!items.length) {
+      box.innerHTML = '<p class="text-slate-500 text-xs">Nessun contenuto. Aggiungine uno qui sotto.</p>';
+      return;
+    }
+    box.innerHTML = items.map(function(d) {
+      return '<div class="border border-slate-700 rounded-xl p-3 space-y-2" data-dl="' + d.id + '">' +
+        '<input type="text" value="' + escapeHtml(d.titolo || '') + '" data-field="titolo" class="auth-input text-xs" placeholder="Titolo">' +
+        '<input type="text" value="' + escapeHtml(d.descrizione || '') + '" data-field="descrizione" class="auth-input text-xs" placeholder="Descrizione (facoltativa)">' +
+        '<input type="url" value="' + escapeHtml(d.url || '') + '" data-field="url" class="auth-input text-xs" placeholder="https://...">' +
+        '<div class="flex items-center gap-2">' +
+          '<input type="number" value="' + (d.sort_order || 0) + '" data-field="sort_order" class="auth-input text-xs" title="Ordine" style="max-width:84px">' +
+          '<button type="button" onclick="saveDownload(' + d.id + ')" class="btn-secondary text-[11px] px-3 py-1.5 flex-1">Salva</button>' +
+          '<button type="button" onclick="deleteDownload(' + d.id + ')" class="text-red-400 text-[11px] px-3 py-1.5 border border-red-500/30 rounded-lg">Elimina</button>' +
+        '</div>' +
+      '</div>';
+    }).join('');
+  });
+}
+// Ricarica dal DB e riallinea admin + aree visibili
+async function refreshDownloads() {
+  downloadsLoaded = false;
+  await loadDownloads();
+  renderAdminDownloads();
+  var sociSection = document.getElementById('area-soci');
+  if (sociSection && !sociSection.classList.contains('hidden')) renderAreaSoci();
+  var yumaSection = document.getElementById('area-yuma');
+  if (yumaSection && !yumaSection.classList.contains('hidden')) renderAreaYuma();
+}
+async function addDownload(area) {
+  if (!isAdmin || !supabaseClient) return;
+  var p = area === 'soci' ? 'new-dl-soci-' : 'new-dl-yuma-';
+  var titoloEl = document.getElementById(p + 'titolo');
+  var descEl = document.getElementById(p + 'desc');
+  var urlEl = document.getElementById(p + 'url');
+  var titolo = ((titoloEl && titoloEl.value) || '').trim();
+  if (!titolo) { alert('Inserisci un titolo.'); return; }
+  var maxOrder = areaDownloads(area).reduce(function(mx, d) { return Math.max(mx, d.sort_order || 0); }, 0);
+  var res = await supabaseClient.from('downloads').insert({
+    area: area,
+    titolo: titolo,
+    descrizione: ((descEl && descEl.value) || '').trim() || null,
+    url: ((urlEl && urlEl.value) || '').trim() || null,
+    sort_order: maxOrder + 1,
+    created_by: currentUser ? currentUser.id : null
+  });
+  if (res.error) { alert('Errore: ' + res.error.message); return; }
+  if (titoloEl) titoloEl.value = '';
+  if (descEl) descEl.value = '';
+  if (urlEl) urlEl.value = '';
+  await refreshDownloads();
+}
+async function saveDownload(id) {
+  if (!isAdmin || !supabaseClient) return;
+  var card = document.querySelector('[data-dl="' + id + '"]');
+  if (!card) return;
+  var payload = {};
+  card.querySelectorAll('[data-field]').forEach(function(inp) {
+    var f = inp.getAttribute('data-field'), v = inp.value;
+    if (f === 'sort_order') payload[f] = parseInt(v, 10) || 0;
+    else payload[f] = v.trim() || null;
+  });
+  if (!payload.titolo) { alert('Titolo obbligatorio.'); return; }
+  var res = await supabaseClient.from('downloads').update(payload).eq('id', id);
+  if (res.error) { alert('Errore: ' + res.error.message); return; }
+  await refreshDownloads();
+}
+async function deleteDownload(id) {
+  if (!isAdmin || !supabaseClient) return;
+  if (!confirm('Eliminare questo contenuto?')) return;
+  var res = await supabaseClient.from('downloads').delete().eq('id', id);
+  if (res.error) { alert('Errore: ' + res.error.message); return; }
+  await refreshDownloads();
 }
 
