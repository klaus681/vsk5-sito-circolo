+/* -------------------------------------------------------------------
+   CONTENUTI DELLE AREE (tabella `downloads`)
+   Li pubblica solo l'admin dal pannello (tab "Aree"); le due aree li
+   leggono filtrando per `area` ('soci' | 'yuma'). La RLS fa il resto:
+   vedi supabase/101-downloads.sql.
+   ------------------------------------------------------------------- */
+function safeUrl(u) {
+  var s = String(u || '').trim();
+  return /^https?:\/\//i.test(s) ? s : '';
+}
+const SOCI_ACCENT = { title: 'text-emerald-400', badge: 'border-emerald-500/40 text-emerald-300 bg-emerald-500/10', border: 'border-emerald-500/20' };
+const YUMA_ACCENT = { title: 'text-amber-400', badge: 'border-amber-500/40 text-amber-300 bg-amber-500/10', border: 'border-amber-500/20' };
+function areaDownloads(area) {
+  return (downloadsCache || [])
+    .filter(function(d) { return d.area === area; })
+    .sort(function(a, b) {
+      return ((a.sort_order || 0) - (b.sort_order || 0)) || ((a.id || 0) - (b.id || 0));
+    });
+}
+async function loadDownloads() {
+  if (!supabaseClient) { downloadsCache = []; downloadsLoaded = true; return downloadsCache; }
+  try {
+    var res = await supabaseClient.from('downloads').select('*')
+      .order('sort_order', { ascending: true }).order('id', { ascending: true });
+    downloadsCache = (!res.error && res.data) ? res.data : [];
+  } catch (e) {
+    downloadsCache = [];
+  }
+  downloadsLoaded = true;
+  return downloadsCache;
+}
+// Card "Area Download" di una delle due aree.
+function downloadsPanelHtml(area, titleKey, accent) {
+  var _t = typeof t === 'function' ? t : function(k) { return k; };
+  var items = areaDownloads(area);
+  var title = escapeHtml(_t(titleKey));
+  var head = '<div class="flex items-start justify-between gap-2">' +
+      '<div class="text-xs font-semibold uppercase tracking-wider ' + accent.title + '">' + title + '</div>' +
+      '<span class="shrink-0 text-[10px] font-bold uppercase px-2 py-0.5 rounded border ' + accent.badge + '">' +
+        (items.length ? String(items.length) : escapeHtml(_t('area_soon'))) +
+      '</span>' +
+    '</div>';
+
+  if (!items.length) {
+    return '<div class="glass-card p-5 rounded-2xl ' + accent.border + '">' + head +
+      '<p class="text-slate-400 text-xs mt-2">' + escapeHtml(_t('area_download_desc')) + '</p>' +
+      '<p class="text-slate-500 text-xs mt-1">' + escapeHtml(_t('area_download_empty')) + '</p>' +
+    '</div>';
+  }
+
+  var rows = items.map(function(d) {
+    var href = safeUrl(d.url);
+    var desc = d.descrizione ? '<p class="text-slate-400 text-xs mt-0.5">' + escapeHtml(d.descrizione) + '</p>' : '';
+    var open = href ? '<span class="shrink-0 text-[10px] font-bold uppercase px-2 py-0.5 rounded border ' + accent.badge + '">' + escapeHtml(_t('area_download_open')) + '</span>' : '';
+    var inner = '<div class="flex items-start justify-between gap-3">' +
+        '<div class="min-w-0"><div class="text-sm font-semibold text-white break-words">' + escapeHtml(d.titolo || '') + '</div>' + desc + '</div>' + open +
+      '</div>';
+    var cls = 'block border rounded-xl p-3 transition ' + accent.border;
+    return '<li>' + (href
+      ? '<a href="' + escapeHtml(href) + '" target="_blank" rel="noopener noreferrer" class="' + cls + ' hover:bg-slate-800/40">' + inner + '</a>'
+      : '<div class="' + cls + '">' + inner + '</div>') + '</li>';
+  }).join('');
+
+  return '<div class="glass-card p-5 rounded-2xl ' + accent.border + '">' + head +
+    '<ul class="space-y-2 mt-3">' + rows + '</ul>' +
+  '</div>';
+}
+
 function renderAreaSoci() {
   var _t = typeof t === 'function' ? t : function(k, v) {
     var s = k;
